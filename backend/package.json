{
  "name": "wongkito-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API Warkop Wong Kito (Express + PostgreSQL)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "init-db": "tsx --env-file-if-exists=.env src/initDb.ts",
    "reset-owner": "tsx --env-file-if-exists=.env src/initDb.ts --reset-owner",
    "typecheck": "tsc --noEmit",
    "test:logger": "node test-logger.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
