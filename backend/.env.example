# Copy to .env and fill in. Never commit .env.

# Port of this Express server. The frontend forwards /api/* here (frontend/.env.example → BACKEND_URL).
PORT=4000

# PostgreSQL connection.
# Local example: postgres://wongkito:YOUR_PASSWORD@localhost:5432/wongkito
# Hosted (Supabase/Neon/etc.) usually needs SSL: append ?sslmode=require
DATABASE_URL=

# Address of the frontend, allowed for CORS and for write requests (comma-separated for several).
FRONTEND_URL=http://localhost:3000
